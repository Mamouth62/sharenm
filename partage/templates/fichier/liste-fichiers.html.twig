{% extends 'base.html.twig' %}

{% block title %}Liste des fichiers{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Liste des fichiers</h1>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nom du fichier</th>
                    <th>Nom de l'utilisateur</th>
                    <th>Prénom de l'utilisateur</th>
                    <th>Date d'envoi</th>
                    <th>Extension</th>
                    <th>Taille</th>
                </tr>
            </thead>
            <tbody>
                {% for fichier in fichiers %}
                    <tr>
                        <td>{{ fichier.nomOriginal }}</td>
                        <td>{{ fichier.user.nom }}</td>
                        <td>{{ fichier.user.prenom }}</td>
                        <td>{{ fichier.dateEnvoi|date('d/m/Y') }}</td>
                        <td>{{ fichier.extension }}</td>
                        <td>{{ fichier.taille }} octets</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun fichier trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
