{% extends 'base.html.twig' %}

{% block title %}Ajouter une catégorie{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="text-center text-primary mb-4">Ajouter une catégorie</h1>

        <div class="row justify-content-center">
            <div class="col-12 col-md-6 bg-light p-4 border rounded shadow-sm">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.libelle, 'Nom de la catégorie', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le nom de la catégorie'}}) }}
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">Ajouter</button>
                        <a href="{{ path('app_liste_categories') }}" class="btn btn-secondary">Retour à la liste</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
